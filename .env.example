# Aura AI 2.0 — Environment Configuration
# Copy from .env.example and fill in your API keys

# --- Application ---
APP_NAME=AuraAI
APP_VERSION=2.0.0
DEBUG=true
ENVIRONMENT=development
LOG_LEVEL=DEBUG

# --- Server ---
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

# --- Database (PostgreSQL) ---
POSTGRES_USER=aura
POSTGRES_PASSWORD=aura_dev_password_change_me
POSTGRES_DB=aura_ai
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# --- Redis ---
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

# --- JWT Authentication ---
JWT_SECRET_KEY=dev_secret_key_CHANGE_ME_IN_PRODUCTION_64chars_minimum
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# --- CORS ---
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173,http://localhost:80,http://127.0.0.1:5500,http://localhost:5500,null

# --- Rate Limiting ---
RATE_LIMIT_PER_MINUTE=60

# --- AI Providers (set at least one) ---
NVIDIA_NIM_API_KEY=
NVIDIA_NIM_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_NIM_MODEL=meta/llama-3.2-11b-vision-instruct

GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

AI_PROVIDER_PRIORITY=nvidia_nim,gemini,openai

# ── Text to Speech (TTS) ────────────────────────────────────────────────────────
# CPU-friendly default; no NVIDIA/Riva runtime is required.
TTS_PROVIDER=edge_tts
TTS_VOICE=hi-IN-SwaraNeural

# NVIDIA TTS Configuration (Magpie or regular Riva TTS)
NVIDIA_TTS_URI=grpc.nvcf.nvidia.com:443
# NVIDIA_TTS_FUNCTION_ID=eaecb41a-a0f1-4ef4-9d56-78ab3a30abf3  # Uncomment for Magpie Multilingual on Cloud NVCF

# ── Speech to Text (STT) ────────────────────────────────────────────────────────---
STT_PROVIDER=whisper
STT_MODEL_SIZE=base
STT_LANGUAGE=hi
STT_COMPUTE_TYPE=int8
